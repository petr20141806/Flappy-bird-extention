{
  "manifest_version": 3,
  "name": "Flappy Bird Mini",
  "version": "1.1.0",
  "description": "Пиксельная аркада с ручным управлением, автопилотом и настройками.",
  "action": {
    "default_title": "Flappy Bird Mini",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}